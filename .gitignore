alert_manager/alerts.db
alert_manager/watchdog.log
alert_manager/nemesis.log
*.log
*.db
*.db-wal
*.db-shm
*.db-journal
__pycache__/
*.pyc
.env
.claude/
alert_manager/quarantine/
*.state.json

# Flask session secret (generated at runtime — never commit)
alert_manager/.flask_secret

# Agent secrets / local config (generated per-device at runtime — never commit)
nemesis_agent/keys/
*.conf

# Windows agent build artifacts (PyInstaller / bundled ClamAV)
nemesis_agent/clamav/
nemesis_agent/dist/
nemesis_agent/build/
*.spec
nemesis_agent/lhm/

# Generated morning briefing/audit reports (local-only, regenerated each session)
docs/briefing/

# Collaboration/working-style notes (local-only; @-imported into CLAUDE.md from disk)
docs/COLLABORATION.md

# Installer sidecar conf — can hold a live enrollment token + Tailscale pre-auth key
# (build_installer.py --token bakes one locally); must NEVER be committed (Rule 8).
nemesis_install.conf

# migrate_to_opt.sh's runtime marker — records the pre-migration mode/path for
# --rollback. Repo-root, untracked-but-present after any real migration run;
# excluded rather than deleted, since do_rollback still needs to read it.
.nemesis-premigration-mode

# Local security-test reports & artifacts — not committed for now (2026-07-29)
docs/testing/
