[Unit]
Description=Nemesis Alert Watcher
# Suricata creates the fast.log this service tails.
After=suricata.service network-online.target
Wants=suricata.service

[Service]
Type=simple
User=nemesis-alertw
Group=nemesis-db
EnvironmentFile=/etc/nemesis.env

# Activates runtime privilege attestation (nemesis_privsep). Absent =>
# the check stays inert, which is what makes the code safe pre-migration.
Environment=NEMESIS_EXPECT_USER=nemesis-alertw
Environment=NEMESIS_DB_PATH=/var/lib/nemesis/alerts.db

ExecStart=/usr/bin/python3 /opt/nemesis/alert_manager/alert_watcher.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

LogsDirectory=nemesis/alert-watcher
LogsDirectoryMode=0750
# 0770 on the data dir: SQLite in WAL mode creates -wal/-shm siblings
# there, so the service group needs directory write, not just traverse.
ReadWritePaths=/var/lib/nemesis

# --- privilege boundary (identical across all Nemesis units) ------------------
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
