# Shared environment for nemesis services (dashboard, watchdog, alert-watcher).
# Owner: root  Mode: 600  Path: /etc/nemesis.env
# Keep this file out of version control.

# Hardware sensor source.  Leave unset (or omit) for the default Linux/lm-sensors path.
# Set to "windows_agent" to skip lm-sensors entirely and receive pre-labelled sensor
# data via POST /hw_data on port 5001 from the Windows agent (windows_agent/agent.py).
# You also need {"source": "windows_agent"} in alert_manager/hw_map.json.
# HW_SOURCE=windows_agent

ABUSEIPDB_KEY=
IPINFO_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_INPUT_PRICE_PER_MTOK=3.00
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=15.00
WATCHDOG_EMAIL=
WATCHDOG_PASSWORD=
PIHOLE_PASSWORD=
