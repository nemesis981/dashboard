// Nemesis: allow the watchdog service user to restart ONLY the units it supervises.
//
// Grants the de-privileged watchdog service exactly the restart authority it
// needs, and nothing else. Every other unit and every other verb falls through
// to deny.
//
// THIS LIST MUST COVER core_module/watchdog/watchdog.py's SERVICES LIST.
// Until 2026-09-04 it did not, and the mismatch failed in the worst direction:
// watchdog supervised 6 units but was authorised for only 3 of them. For
// pihole-FTL, clamav-daemon and suricata it would detect the outage, attempt
// `systemctl restart`, be denied by polkit, and report "down and could not be
// restarted" -- which reads as a broken service rather than a missing permission.
// The original list enumerated NEMESIS units; watchdog also supervises three
// third-party daemons. Including them extends a de-privileged service's authority
// beyond Nemesis's own units -- narrowly, to exactly the units it already
// monitors, and to the restart verbs only.
// alert_manager/test_watchdog_restart_authority.py enforces the coverage.
//
// watchdog is the one de-privileged service with a genuine privilege need:
// systemctl restart <unit> for the services it supervises. This grants exactly
// that and nothing else — not blanket sudo, not root, and not authority over
// any unit outside this list.
//
// Deployed by install.sh to /etc/polkit-1/rules.d/10-nemesis-watchdog.rules (root:root 0644)

polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return undefined;
    }
    if (subject.user !== "nemesis-watchdog") {
        return undefined;
    }

    var unit = action.lookup("unit");
    var allowed = [
        "dashboard.service",
        "hw-monitor.service",
        "alert-watcher.service",
        "device-scanner.service",
        "malware-canary.service",
        "diagnostics-watcher.service",
        "vpn-dns-guard.service",
        // Third-party daemons watchdog supervises (added 2026-09-04).
        "pihole-FTL.service",
        "clamav-daemon.service",
        "suricata.service"
    ];
    if (allowed.indexOf(unit) < 0) {
        return undefined;          // fall through to default (deny)
    }

    // Restrict to the verbs the watchdog actually uses. `status`/`is-active`
    // need no privilege at all and are deliberately absent.
    var verb = action.lookup("verb");
    if (verb === "restart" || verb === "try-restart") {
        return polkit.Result.YES;
    }
    return undefined;
});
