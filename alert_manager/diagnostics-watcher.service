[Unit]
Description=Nemesis Connectivity Diagnostics Watcher
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/nemesis.env
ExecStart=/usr/bin/python3 /home/<user>/dashboard/alert_manager/diagnostics_watcher.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
