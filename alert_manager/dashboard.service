[Unit]
Description=Security Dashboard
After=network.target

[Service]
Type=simple
User=nemesis-dash
Group=nemesis-db
WorkingDirectory=/opt/nemesis
Environment=PYTHONPATH=/opt/nemesis/alert_manager:/opt/nemesis/core_module/hw_monitor
EnvironmentFile=-/etc/watchdog.env
EnvironmentFile=/etc/nemesis.env

Environment=NEMESIS_DB_PATH=/var/lib/nemesis/alerts.db

ExecStart=/usr/bin/python3 /opt/nemesis/dashboard.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

LogsDirectory=nemesis/dashboard
LogsDirectoryMode=0750
# 0770 on the data dir: SQLite in WAL mode creates -wal/-shm siblings
# there, so the service group needs directory write, not just traverse.
ReadWritePaths=/var/lib/nemesis

# --- privilege boundary (identical across all Nemesis units) ------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
