#!/bin/bash
# ADR 0019 — Increment 4: render nemesis_enforce rules DERIVED from the
# authoritative backend, WITH REAL ENFORCEMENT AUTHORITY.
#
# SINGLE-AUTHORITY CONSTRAINT (operator, 2026-07-30): the table is DERIVED,
# never independently populated. Rules are generated from what ufw is ACTUALLY
# ENFORCING right now — not from the DB, not from caller intent. If callers
# could write here directly, the two rule sets would drift and the comparison
# that justifies cutover would be measuring our own bookkeeping error rather
# than real agreement.
#
# ENFORCING BY DEFAULT (Increment 4 cutover). Each derived block emits a
# rate-limited logging rule that falls through, plus an unconditional `drop`.
# Set NEMESIS_FW_ENFORCE=0 to render the old observe-only form.
#
# ADDITIVE: ufw keeps enforcing exactly as before. The behavioural change is not
# that blocked addresses get blocked — they already were — it is that this
# closes an established-connection gap in the current interim path: a block
# that previously only stopped new connections now also ends existing ones.
#
# The chain policy stays `accept`, so only addresses ufw is ALREADY blocking can
# ever be dropped here, and the never-block guard below refuses a verdict for any
# protected address. Those two constraints are what bound the lockout risk.
#
# THE COMPARISON THIS ENABLES: same rules, same traffic, two engines. If the
# table's counter for an address increments while ufw's DROP counter for the
# same address does not (or vice versa), the two disagree — and one of them is
# wrong. Divergence is the signal; agreement over a real workload is what
# justifies cutover.
#
# NEVER-BLOCK GUARD: every derived address is classified by
# scripts/nemesis-fw-neverblock, which shells out to firewall.never_block_set() —
# the SAME list the live chokepoint consults before every block, never a second
# copy. A protected address stays visible in the table with a counter and a
# `never-block:refused:` comment, and can never be given a verdict. If the guard
# cannot run, this script emits NOTHING and exits 3: an enforcement table without
# a working never-block check is worse than no table.
#
#   render        write the derived ruleset to stdout
#   render -o F   write to file F
set -u

OUT="${2:-/dev/stdout}"
[ "${1:-render}" = "render" ] || { echo "usage: $0 render [-o file]"; exit 1; }
[ "${2:-}" = "-o" ] && OUT="${3:?-o needs a path}"

# ── source of truth: what ufw is enforcing THIS INSTANT ──────────────────────
# Per-IP blocks land in ufw-user-input as `-s <addr> -j DROP` with no protocol
# or port match — that is the shape nemesis_fwd's block_ip produces.
mapfile -t V4 < <(iptables -S ufw-user-input 2>/dev/null \
    | grep -E '^-A ufw-user-input -s [0-9.]+/[0-9]+ -j DROP$' \
    | awk '{print $4}')
mapfile -t V6 < <(ip6tables -S ufw6-user-input 2>/dev/null \
    | grep -E '^-A ufw6-user-input -s [0-9a-fA-F:]+/[0-9]+ -j DROP$' \
    | awk '{print $4}')

# ── enforcement switch (ADR 0019 Increment 4) ────────────────────────────────
# ON unless explicitly disabled. THE CUTOVER HAS HAPPENED: `1bedbb3` (2026-08-01)
# flipped this default from 0 to 1, 34 minutes after `df24480` introduced it gated
# off. Set NEMESIS_FW_ENFORCE=0 to force observe-only.
#
# This comment previously read "OFF unless explicitly enabled" and described the
# cutover as still pending — it had been contradicting the line directly beneath it
# since 1bedbb3. Corrected 2026-08-27. That is precisely the defect Amendment 02
# exists to prevent ("the system's own description of its enforcement posture
# disagreed with its actual enforcement"), recurring one line above the code it
# describes, so it is worth stating plainly rather than quietly fixing.
#
# "Is this box enforcing?" remains answerable from `git log` rather than from
# invisible runtime state, and rollback is still one revert — the answer is just
# `1bedbb3`, not "no".
#
# ⚠ THREE DOCUMENTS STILL DISAGREE WITH THIS LINE and are the next thing to fix:
#   - the public ADR 0019 status table says Increment 4 is "Not started";
#   - Amendment 02 §6.1 says observe-only is "live today" (written 2026-08-08,
#     a week AFTER the cutover);
#   - Amendment 02's rollout step 3 says a mode detector should "confirm it reports
#     OBSERVE today". That detector (`nemesis-fw-mode`) is designed but UNBUILT, so
#     nothing currently cross-checks declared mode against the live table at all.
#
# A refused address NEVER receives a verdict regardless of this switch.
ENFORCE="${NEMESIS_FW_ENFORCE:-1}"

# Tailnet interface for the loop-prevention DROP below. NAME-matched, deliberately:
# this is OUR OWN component with a stable name, unlike a user's VPN device whose name
# is arbitrary (which is why vpn_dns_guard kind-matches those instead). Overridable
# for the rare non-default tun name.
# ⚠ CONFIG MUST BE READ FROM PERSISTENT STATE, NOT INHERITED FROM THE CALLER.
#
# Found the hard way on the VM rig 2026-08-30: the gateway SNAT chain was rendered
# correctly, loaded correctly, and had VANISHED within seconds. `nemesis-fw-watch`
# re-renders this script autonomously on ufw drift, IN ITS OWN ENVIRONMENT -- so
# anything supplied only as an environment variable by a one-off invocation is
# silently dropped from the very next re-render. The chain existed for about two
# seconds and the traffic then left un-NATted, with every surface reporting success.
#
# So the standing "the renderer emits all forward/NAT rules" constraint is necessary
# but NOT sufficient: the renderer must also be able to REPRODUCE the same output
# from persistent state on an invocation nobody configured. Values are read from
# /etc/nemesis.env (the established config location), with the process environment
# taking precedence so tests can override without touching system config.
#
# Read by targeted grep rather than sourcing the file: /etc/nemesis.env holds
# secrets, and sourcing it wholesale would pull them into the render environment for
# no reason.
NEMESIS_ENV_FILE="${NEMESIS_ENV_FILE:-/etc/nemesis.env}"
_envget() {
    local key="$1"
    [ -r "$NEMESIS_ENV_FILE" ] || return 0
    sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$NEMESIS_ENV_FILE" \
        | tail -1 | sed 's/^"//; s/"$//; s/^'"'"'//; s/'"'"'$//'
}

TS_IFACE="${NEMESIS_TS_IFACE:-$(_envget NEMESIS_TS_IFACE)}"
TS_IFACE="${TS_IFACE:-tailscale0}"

# ── Gateway Mode SNAT (step 2) ────────────────────────────────────────────────
# BOTH must be set or no NAT chain is emitted at all. Gateway Mode is off by
# default and an unconfigured masquerade is meaningless, so the safe state is
# "the chain does not exist" rather than "the chain exists and matches nothing".
GW_LAN_IFACE="${NEMESIS_GW_LAN_IFACE:-$(_envget NEMESIS_GW_LAN_IFACE)}"
GW_LAN_CIDR="${NEMESIS_GW_LAN_CIDR:-$(_envget NEMESIS_GW_LAN_CIDR)}"

# ── never-block guard ────────────────────────────────────────────────────────
# FAIL-CLOSED, and deliberately strict: an enforcement table without a working
# never-block check is worse than no table, so a guard that cannot run stops the
# render entirely rather than producing an unguarded ruleset.
#
# THIS RUNS BEFORE $OUT IS OPENED. `{ ... } > "$OUT"` truncates on open, so a
# guard failure discovered after that point would leave a half-written or empty
# ruleset behind. Refusing here leaves any existing file byte-identical.
#
# STRICT EVEN THOUGH TODAY'S OUTPUT HAS NO VERDICTS. The guard's failure modes
# are worth exercising now, in the regime where a mistake cannot lock anyone out,
# rather than being discovered at cutover when they can.
GUARD="$(dirname "$(readlink -f "$0")")/nemesis-fw-neverblock"
CAND=$(printf '%s\n' "${V4[@]:-}" "${V6[@]:-}" | grep . || true)
GERR=$(mktemp)
if ! GOUT=$(printf '%s\n' "$CAND" | grep . | "$GUARD" 2>"$GERR"); then
    cat "$GERR" >&2
    rm -f "$GERR"
    echo "nemesis-fw-render: never-block guard unavailable — REFUSING to emit a" >&2
    echo "  ruleset at all. $OUT was NOT modified. Fix the guard, then re-render." >&2
    exit 3
fi
rm -f "$GERR"

# The guard must answer for EVERY candidate. A short reply means it stopped
# part-way, and a partial answer accepted as a complete one is precisely the
# defect class this change exists to prevent.
WANT=$(printf '%s\n' "$CAND" | grep -c . || true)
GOT=$(printf '%s\n' "$GOUT" | grep -c . || true)
if [ "$WANT" -ne "$GOT" ]; then
    echo "nemesis-fw-render: guard answered for $GOT of $WANT candidate(s) —" >&2
    echo "  refusing to emit a partially-guarded ruleset. $OUT not modified." >&2
    exit 3
fi

# Keyed on the VERBATIM string the guard echoed back, so the lookup below is
# exact by construction. Nothing here re-derives or re-formats an address.
declare -A REFUSED=()
while IFS=$'\t' read -r _v _addr _why; do
    [ "$_v" = "REFUSE" ] && REFUSED["$_addr"]="$_why"
done <<< "$GOUT"

{
echo "# GENERATED — do not hand-edit. Derived from ufw's live ruleset by"
echo "# nemesis-fw-render. $( [ "$ENFORCE" = "1" ] && echo "ENFORCING: derived rules are enforced, not observed." || echo "Observe-only: counters and logs, no verdicts." )"
echo "# Derived $( [ ${#V4[@]} -gt 0 ] && echo ${#V4[@]} || echo 0 ) IPv4 and $( [ ${#V6[@]} -gt 0 ] && echo ${#V6[@]} || echo 0 ) IPv6 block(s)."
echo "# Never-block guard: PASSED. ${#REFUSED[@]} address(es) refused a verdict."
echo "# ENFORCING: $( [ "$ENFORCE" = "1" ] && echo "YES — these rules DROP" || echo "no (observe-only, no verdicts)" )"
# ATOMIC REPLACE, not append. `nft -f` on an EXISTING table adds rules rather
# than replacing them — so without this, every apply duplicates every rule and
# the derived block list accumulates instead of being regenerated. That breaks
# the single-source-of-truth property this whole increment depends on.
# The bare `table` line ensures it exists so `delete` cannot error; the three
# statements load as one atomic transaction.
echo "table inet nemesis_enforce"
echo "delete table inet nemesis_enforce"
echo "table inet nemesis_enforce {"
echo "    chain input {"
echo "        type filter hook input priority -300; policy accept;"
echo "        counter comment \"nemesis:input:traversed\""

if [ ${#V4[@]} -eq 0 ] && [ ${#V6[@]} -eq 0 ]; then
    echo "        # no blocks currently enforced by ufw — nothing to mirror"
fi
for a in "${V4[@]:-}"; do
    [ -n "$a" ] || continue
    if [ -n "${REFUSED[$a]:-}" ]; then
        # VISIBLE, NOT DROPPED. Omitting the address would make this table
        # disagree with ufw for a reason no operator could see from the table;
        # including it normally would be the lockout. It stays, counted and
        # logged, under a comment tag that states exactly why it will never be
        # given a verdict — so both an operator and nemesis_fw_watch can find it.
        echo "        ip saddr $a counter limit rate 10/minute log prefix \"nemesis-neverblock refused \" comment \"never-block:refused:$a\""
        echo "nemesis-fw-render: REFUSED $a — protected (matches ${REFUSED[$a]}). Rule kept for visibility WITHOUT a verdict; it will never be given one." >&2
    elif [ "$ENFORCE" = "1" ]; then
        # TWO RULES, DELIBERATELY — do not collapse them into one.
        #
        # `limit` is a MATCH, not a log modifier: "a rule using this statement
        # will match until this limit is reached" (nft(8), LIMIT STATEMENT). A
        # verdict appended after `limit rate 10/minute` is therefore reached only
        # while under that rate — it would drop ~10 packets a minute and pass
        # every other packet, which reads as enforcement in the ruleset and is
        # not enforcement at all.
        #
        # So the rate limit stays on the LOGGING rule, which carries no verdict
        # and falls through, and the drop is its own unconditional rule.
        # LOG PREFIX CARRIES NO VERDICT WORD, deliberately. Every tool that
        # counts verdicts reads rule text, and a prefix containing "drop" is
        # indistinguishable from a real verdict without parsing nft grammar --
        # it inflated the Increment 4 gate's own count on first run. "blocked"
        # says the same thing and collides with nothing.
        echo "        ip saddr $a counter limit rate 10/minute log prefix \"nemesis-enforce blocked \" comment \"enforce:log:$a\""
        echo "        ip saddr $a counter drop comment \"enforce:block:$a\""
    else
        # No verdict: counts and logs, then falls through. Log is rate-limited —
        # an unbounded log rule on a blocked host that keeps retrying is a
        # self-inflicted disk problem.
        echo "        ip saddr $a counter limit rate 10/minute log prefix \"nemesis-observe would-drop \" comment \"observe:block:$a\""
    fi
done
for a in "${V6[@]:-}"; do
    [ -n "$a" ] || continue
    if [ -n "${REFUSED[$a]:-}" ]; then
        echo "        ip6 saddr $a counter limit rate 10/minute log prefix \"nemesis-neverblock refused6 \" comment \"never-block6:refused:$a\""
        echo "nemesis-fw-render: REFUSED $a — protected (matches ${REFUSED[$a]}). Rule kept for visibility WITHOUT a verdict; it will never be given one." >&2
    elif [ "$ENFORCE" = "1" ]; then
        # Split for the same reason as the v4 loop above — see that comment.
        echo "        ip6 saddr $a counter limit rate 10/minute log prefix \"nemesis-enforce blocked6 \" comment \"enforce:log6:$a\""
        echo "        ip6 saddr $a counter drop comment \"enforce:block6:$a\""
    else
        echo "        ip6 saddr $a counter limit rate 10/minute log prefix \"nemesis-observe would-drop6 \" comment \"observe:block6:$a\""
    fi
done

cat <<'NFT'
    }
    chain forward {
        type filter hook forward priority -300; policy accept;
        counter comment "nemesis:forward:traversed"
        # ── Tailnet loop-prevention DROP (Gateway Mode step 1b) ──────────────
        #
        # REPLICATES Tailscale's own ts-forward rule, which we do NOT get for free
        # because `--netfilter-mode=nodivert` (set by configure_tailnet_enforcement
        # since 2026-07-30) means ts-forward is MAINTAINED but never jumped from
        # FORWARD. Its INPUT sibling -- the tailnet anti-spoof DROP -- was already
        # replicated into ufw's before.rules for exactly this reason; this is the
        # forward-side counterpart that was left outstanding, and install.sh says so:
        # "ts-forward is also unjumped: replicate its loop-prevention DROP and the
        # nat-table SNAT before enabling ip_forward".
        #
        # Form taken from Tailscale's own source (util/linuxfw, addBase4), not
        # inferred from a running box:
        #     ["-o", tunname, "-s", tsaddr.CGNATRange().String(), "-j", "DROP"]
        # i.e. drop anything being FORWARDED OUT the tailnet interface that already
        # carries a tailnet source -- which would be tailnet traffic re-entering the
        # tailnet, a routing loop.
        #
        # INERT UNTIL FORWARDING IS ENABLED, deliberately. With ip_forward=0 the
        # kernel never invokes the forward hook, so this rule can land well ahead of
        # Gateway Mode and be in place BEFORE the switch flips -- which is the
        # ordering install.sh warns about, in the safe direction.
        #
        # ⚠ IPv4 ONLY, and that gap is INHERITED, not introduced. Tailscale's own
        # addBase6 has no CGNAT-DROP equivalent (a TODO in their source), so an IPv6
        # rule here would DIVERGE from upstream on a security rule rather than
        # replicate it. Replicating what exists and documenting what does not is the
        # honest option; adding an untested IPv6 rule that could break legitimate
        # tailnet forwarding is not. Revisit if upstream closes it.
NFT
echo "        oifname \"$TS_IFACE\" ip saddr 100.64.0.0/10 counter drop comment \"nemesis:forward:tailnet-loop\""
cat <<'NFT'
    }
    chain output {
        type filter hook output priority -175; policy accept;
        counter comment "nemesis:output:traversed"
    }
NFT

# ── Gateway Mode source-NAT ───────────────────────────────────────────────────
#
# ⚠ THIS CHAIN LIVES INSIDE nemesis_enforce DELIBERATELY, not in a table of its own.
# Both `nemesis-fw-apply` and `nemesis_fw_watch.py` are scoped to `inet
# nemesis_enforce` BY NAME (apply reverts with `nft delete table inet
# nemesis_enforce`; the watcher keys on TABLE_NAME). A separate `nemesis_gw_nat`
# table -- the shape the 2026-08-06 gateway-zone experiment used -- would therefore
# sit OUTSIDE both: it would SURVIVE a failsafe revert, leaving NAT live after the
# enforcement table had been rolled back, and it would be invisible to tamper
# detection. One table means one owner, one atomic revert, one watched object.
#
# ⚠ NEGATIVE SCOPE (`oifname !=`), NOT `-o <derived egress>`. This is the shape
# proven on the VM rig 2026-08-30. Scoping to a DERIVED egress interface fails
# whenever the route changes underneath it: with a split-tunnel VPN up, traffic
# leaves via the tunnel while the derivation still (correctly) reports the physical
# NIC, the rule never matches, and packets exit UN-NATTED carrying the client's
# private source. Measured: 6 such packets. Scoping instead by the interface that
# must NOT be translated -- the LAN side, a configuration fact we own -- was proven
# correct in BOTH VPN states. Do not "simplify" this back to a positive match.
#
# IPv4 only: NATing IPv6 is not a goal, and `ip saddr` here matches v4 in the inet
# family by construction.
if [ -n "$GW_LAN_IFACE" ] && [ -n "$GW_LAN_CIDR" ]; then
    echo "    chain gateway_snat {"
    echo "        type nat hook postrouting priority srcnat; policy accept;"
    echo "        ip saddr $GW_LAN_CIDR oifname != \"$GW_LAN_IFACE\" counter masquerade comment \"nemesis:nat:gateway-snat\""
    echo "    }"
fi

cat <<'NFT'
}
NFT
} > "$OUT"

# ⚠ AN `if`, NOT `[ ... ] && echo`. As the LAST statement in the script, the
# short-circuit form leaks its own status: when $OUT IS /dev/stdout the test is
# false, the `&&` never runs, and the script EXITS NON-ZERO despite having
# rendered perfectly. Pre-existing (exit 3 before the gateway work, 1 after), and
# it means any caller doing `render > f && nft -f f` silently skips the load --
# which is exactly how it was found. The `-o` form used by nemesis-fw-enforce
# takes the true branch and always exited 0, so production was never affected.
if [ "$OUT" != "/dev/stdout" ]; then
    echo "  wrote $OUT (${#V4[@]} v4, ${#V6[@]} v6 derived rules, ${#REFUSED[@]} refused by the never-block guard)" >&2
fi
